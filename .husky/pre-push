#!/usr/bin/env sh
# Pre-push gates.
#
# 1) Static quality gates (fast): dprint format check, astro check (types), and
#    ESLint. These mirror the CI `static-checks` job so a red check never reaches
#    the PR. Always run -- SKIP_VISUAL does not skip them.
#    Order: typecheck before lint, because `astro check` syncs .astro content
#    types that type-aware ESLint needs to resolve `astro:content`.
# 2) Visual-regression suite (slow, Docker): runs the full Playwright suite in the
#    same arm64-native image the self-hosted CI runner is built FROM, so a passing
#    run means the PNG bytes will match CI. The required `visual-gate` context
#    binds the pixel gate in CI (atlas decision 0168 item 16), so the hook runs the
#    suite only when a pushed commit changes a rendered input against origin/main
#    (scripts/visual-scope.sh, which fails closed and runs the suite when it cannot
#    compute the diff). `SKIP_VISUAL=1 git push` skips it on any push.

# git writes the pushed refs to stdin. Read them before any other command can
# consume them. A manual run from a terminal has no refs, and the scope judges HEAD.
if [ -t 0 ]; then
  PUSH_REFS=''
else
  PUSH_REFS=$(cat)
fi

# 0) Install integrity (fast, fs-only). The doctor runs FIRST so a broken
#    node_modules/.bin symlink is reported clearly here instead of detonating as
#    a cryptic "command not found" inside format:check/lint below.
echo "[pre-push] Preflight: install integrity"

if ! pnpm run doctor:install; then
  echo ""
  echo "ERROR: install integrity check failed (see fix above)."
  echo ""
  exit 1
fi

echo "[pre-push] Static gates: format:check -> typecheck -> lint"

if ! pnpm run format:check; then
  echo ""
  echo "ERROR: dprint format check failed. Fix with:  pnpm run format"
  echo ""
  exit 1
fi

if ! pnpm run typecheck; then
  echo ""
  echo "ERROR: astro check (typecheck) failed. Fix the type errors above."
  echo ""
  exit 1
fi

if ! pnpm run lint; then
  echo ""
  echo "ERROR: eslint failed. Fix the lint errors above (some are auto-fixable:  pnpm exec eslint . --fix)."
  echo ""
  exit 1
fi

if [ "${SKIP_VISUAL:-0}" = "1" ]; then
  echo "[pre-push] SKIP_VISUAL=1 -- bypassing local visual gate. CI will re-verify."
  exit 0
fi

if ! VISUAL_SCOPE=$(printf '%s\n' "$PUSH_REFS" | sh scripts/visual-scope.sh); then
  echo "[pre-push] Visual suite skipped: $VISUAL_SCOPE. CI visual-gate re-verifies."
  exit 0
fi

echo "[pre-push] Running visual regression suite in Docker (arm64-native, CI-parity image): $VISUAL_SCOPE."
echo "[pre-push] To skip: SKIP_VISUAL=1 git push"

if ! pnpm run test:visual; then
  echo ""
  echo "ERROR: visual regression suite failed locally."
  echo ""
  echo "  Open the HTML report:   open playwright-report/index.html"
  echo ""
  echo "  If the diff is intentional (you changed pixels on purpose):"
  echo "      pnpm run test:visual:update"
  echo "      git add tests/visual/__screenshots__/"
  echo "      git commit -m 'chore: regenerate visual baselines'"
  echo ""
  echo "  CI will re-verify the suite on the same image; a clean run here means"
  echo "  the PNG bytes will match CI exactly."
  echo ""
  echo "  Skip the local run (CI visual-gate still blocks the merge):  SKIP_VISUAL=1 git push"
  echo ""
  exit 1
fi
