{
  "$schema": "https://dprint.dev/schemas/v0.json",

  "extends": "./node_modules/@j0nathan-ll0yd/config/dprint.json",

  "includes": [
    "src/**/*.{ts,tsx}",
    "tests/**/*.{ts,tsx}",
    "audits/**/*.{ts,tsx}",
    "scripts/**/*.{mjs,cjs,js}",
    "audits/**/*.{mjs,cjs,js}",
    "*.mjs",
    "*.cjs",
    "*.ts"
  ],

  "excludes": [
    "**/node_modules",
    "**/dist",
    "**/.astro",
    "**/coverage",
    "**/*.d.ts",
    "**/*.astro",
    "src/env.d.ts",

    // Frozen byte-identical snapshots of the llms-structure reference at v1 and v2. Their sha256 is
    // measured by the differential suite in audits/__tests__/llms-differential.test.ts, which differences
    // the live reference against them over a fixed seed and input pool, so a formatter pass would
    // re-record history rather than tidy a file.
    //
    // This list used to hold two more entries -- scripts/audit/lib/llms-structure.mjs and
    // scripts/vendor/openspec-covers.mjs, the vendored contract copies. Atlas decision 0079 item 4
    // wave 2b replaced both with @j0nathan-ll0yd/estate-contracts, which resolves under
    // node_modules -- already excluded above, and no formatter walks it -- so those two exclusions
    // are retired by construction rather than restated.
    "audits/__tests__/fixtures/llms-structure.v1.mjs",
    "audits/__tests__/fixtures/llms-structure.v2.mjs"
  ]
}
