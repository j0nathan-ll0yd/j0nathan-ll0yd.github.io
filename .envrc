# direnv config for the Human Datastream portfolio.
# Enable per-directory: `direnv allow` (re-run after any edit to this file).

# Pin Node to .nvmrc (24.16.0) via the installed nvm. direnv's stdlib has no
# `use nvm`, so source nvm directly and let `nvm use` read .nvmrc.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  # shellcheck disable=SC1091
  \. "$NVM_DIR/nvm.sh"
  nvm use --silent || nvm install
fi

# Prefer repo-local CLIs (astro, vitest, playwright, dprint, ...).
PATH_add node_modules/.bin

# Optional local-only overrides (git-ignored). Put non-CI values here, e.g.:
#   SA_API_KEY=...            # scripts/audit/check-analytics.mjs
#   FIXTURE_VARIATION=...     # named DS fixture for the build (astro.config.mjs)
dotenv_if_exists .env.local
