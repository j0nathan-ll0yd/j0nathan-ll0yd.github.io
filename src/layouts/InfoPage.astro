---
import { getEntry } from 'astro:content';
import { TextPage } from '@j0nathan-ll0yd/web/components';
import { llm } from '@j0nathan-ll0yd/copy';
import Dashboard from './Dashboard.astro';
import { SITE_PAGE_PATHS } from '../../functions/_lib/site-paths';
import { AGENT_PATHS } from '../../functions/_lib/agent-paths.mjs';

// The document shell for /about, /contact, /developers, and /privacy: the Dashboard head,
// then the design system's TextPage, which owns every style. This file supplies only what
// the site knows: the copy strings, and the footer links between the four pages.
interface Props {
  title: string;
  description: string;
  /** The page's own path, so its footer link carries aria-current="page". */
  path: string;
  robots?: string;
  pageType?: string;
  updated?: { label: string; date: string; datetime?: string };
  lede?: string;
}

const { title, description, path, robots, pageType, updated, lede } = Astro.props;

const _identityEntry = await getEntry('copy', 'identity');
if (!_identityEntry) throw new Error('[InfoPage.astro] @j0nathan-ll0yd/copy identity entry missing');
const id = _identityEntry.data;

const links = [
  { href: SITE_PAGE_PATHS.about, label: id.about.title },
  { href: SITE_PAGE_PATHS.contact, label: id.contact.title },
  { href: AGENT_PATHS.developers, label: llm.developers.title },
  { href: SITE_PAGE_PATHS.privacy, label: id.privacy.title },
].map((link) => ({ ...link, current: link.href === path }));
---
<Dashboard title={title} description={description} robots={robots} pageType={pageType}>
  <TextPage title={title} updated={updated} lede={lede} back={{ href: '/', label: id.privacy.backLink }} links={links}>
    <slot />
  </TextPage>
</Dashboard>
