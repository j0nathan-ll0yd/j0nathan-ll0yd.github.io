---
import { getEntry } from 'astro:content';
import { TextPage } from '@j0nathan-ll0yd/web/components';
import Dashboard from './Dashboard.astro';
import { siteNavLinks } from '../lib/site-nav';

// The document shell for /about, /contact, /developers, and /privacy: the Dashboard head,
// then the design system's TextPage, which owns every style. This file supplies only what
// the site knows: the copy strings, and the footer links between the four pages (src/lib/site-nav.ts).
interface Props {
  title: string;
  description: string;
  /** The page's own path, so its footer link carries aria-current="page". */
  path: string;
  robots?: string;
  pageType?: string;
  updated?: { label: string; date: string; datetime?: string };
  lede?: string;
}

const { title, description, path, robots, pageType, updated, lede } = Astro.props;

const _identityEntry = await getEntry('copy', 'identity');
if (!_identityEntry) throw new Error('[InfoPage.astro] @j0nathan-ll0yd/copy identity entry missing');
const id = _identityEntry.data;

const links = siteNavLinks(path);
---
<Dashboard title={title} description={description} robots={robots} pageType={pageType}>
  <TextPage title={title} updated={updated} lede={lede} back={{ href: '/', label: id.navigation.backLink }} links={links}>
    <slot />
  </TextPage>
</Dashboard>
