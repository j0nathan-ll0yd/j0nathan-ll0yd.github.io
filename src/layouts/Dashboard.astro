---
import { getEntry } from 'astro:content';
import { CLOUDFRONT_BASE, ENDPOINTS, LLM_CONTENT_PATHS } from '@lifegames/portal-contract/constants';
import { llm, app } from '@lifegames/copy';
const _identityEntry = await getEntry('copy', 'identity');
if (!_identityEntry) throw new Error('[Dashboard.astro] @lifegames/copy identity entry missing — check yalc link and content.config.ts');
const identity = _identityEntry.data;
const {
  title = identity.seo.title,
  description = identity.person.shortBio,
  ogDescription = identity.person.socialBio,
  robots = 'index, follow',
} = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, '');
const canonicalURL = siteUrl + (Astro.url.pathname === '/' ? '' : Astro.url.pathname);
const ogImage = new URL('/assets/og-image.png', Astro.site);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#06060f">
  <meta name="color-scheme" content="dark">
  <meta name="description" content={description}>
  <meta name="robots" content={robots}>
  <meta name="keywords" content={identity.seo.keywords.join(', ')}>
  {/* Security: CSP + Referrer-Policy served via HTTP headers (functions/_middleware.ts) */}
  <meta name="author" content={identity.person.name}>
  <meta property="og:locale" content="en_US">
  <link rel="canonical" href={canonicalURL}>
  {/* LLM-friendly alternate versions (backend-composed live on CloudFront) */}
  <link rel="alternate" type="text/markdown" href={`${CLOUDFRONT_BASE}${LLM_CONTENT_PATHS.llmsFull}`} title={llm.dashboard.alternateLinkMarkdown}>
  <link rel="alternate" type="text/plain" href={`${siteUrl}/llms.txt`} title={llm.dashboard.alternateLinkPlain}>
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="apple-touch-icon" href="/assets/icon-192.png">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="sitemap" href="/sitemap-index.xml">

  <meta property="og:title" content={title}>
  <meta property="og:description" content={ogDescription}>
  <meta property="og:type" content="profile">
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={identity.a11y.ogImageAlt}>
  <meta property="og:site_name" content={identity.site.name}>
  <meta property="profile:first_name" content={identity.person.firstName}>
  <meta property="profile:last_name" content={identity.person.lastName}>

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={ogDescription}>
  <meta name="twitter:image" content={ogImage}>
  <meta name="twitter:image:alt" content={identity.a11y.ogImageAlt}>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": siteUrl + "#website",
        "name": identity.site.fullName,
        "description": identity.site.description,
        "url": siteUrl,
        "inLanguage": "en-US",
        "publisher": { "@id": siteUrl + "#person" }
      },
      {
        "@type": "ProfilePage",
        "@id": siteUrl + "#profilepage",
        "mainEntity": { "@id": siteUrl + "#person" },
        "url": canonicalURL.toString(),
        "dateCreated": "2026-03-04T00:00:00Z",
        "dateModified": new Date().toISOString(),
        "inLanguage": "en-US"
      },
      {
        "@type": "Person",
        "@id": siteUrl + "#person",
        "name": identity.person.name,
        "alternateName": "j0nathan-ll0yd",
        "jobTitle": identity.person.jobTitle,
        "url": siteUrl,
        "image": {
          "@type": "ImageObject",
          "url": ogImage.toString()
        },
        "sameAs": [
          "https://www.linkedin.com/in/lifegames/",
          "https://github.com/j0nathan-ll0yd"
        ],
        "knowsAbout": identity.seo.expertise,
        "knowsLanguage": ["en"],
        "description": identity.person.longBio
      },
      {
        "@type": "Dataset",
        "@id": siteUrl + "#datastream",
        "name": "Human Datastream",
        "description": llm.dashboard.datasetDescription,
        "creator": { "@id": siteUrl + "#person" },
        "license": siteUrl,
        "isAccessibleForFree": true,
        "variableMeasured": [
          "Resting heart rate (7-day aggregate)",
          "Heart rate variability (7-day aggregate)",
          "Sleep phases and efficiency (7-day aggregate)",
          "Hydration (7-day aggregate)",
          "Activity and workouts (7-day aggregate)",
          "GitHub commits and repositories",
          "Books read and currently reading",
          "Articles starred",
          "Theatre reviews"
        ],
        "distribution": [
          {
            "@type": "DataDownload",
            "name": "LLM discovery index",
            "encodingFormat": "text/plain",
            "contentUrl": `${siteUrl}/llms.txt`
          },
          {
            "@type": "DataDownload",
            "name": "LLM complete content",
            "encodingFormat": "text/markdown",
            "contentUrl": `${CLOUDFRONT_BASE}${LLM_CONTENT_PATHS.llmsFull}`
          },
          {
            "@type": "DataDownload",
            "name": "LLM complete content (Markdown alias)",
            "encodingFormat": "text/markdown",
            "contentUrl": `${CLOUDFRONT_BASE}${LLM_CONTENT_PATHS.indexMarkdown}`
          },
          {
            "@type": "DataDownload",
            "name": "Health JSON",
            "encodingFormat": "application/json",
            "contentUrl": `${CLOUDFRONT_BASE}${ENDPOINTS.health}`
          },
          {
            "@type": "DataDownload",
            "name": "Sleep JSON",
            "encodingFormat": "application/json",
            "contentUrl": `${CLOUDFRONT_BASE}${ENDPOINTS.sleep}`
          },
          {
            "@type": "DataDownload",
            "name": "Focus JSON",
            "encodingFormat": "application/json",
            "contentUrl": `${CLOUDFRONT_BASE}${ENDPOINTS.focus}`
          },
          {
            "@type": "DataDownload",
            "name": "GitHub events JSON",
            "encodingFormat": "application/json",
            "contentUrl": `${CLOUDFRONT_BASE}${ENDPOINTS.githubEvents}`
          },
          {
            "@type": "DataDownload",
            "name": "GitHub starred repos JSON",
            "encodingFormat": "application/json",
            "contentUrl": `${CLOUDFRONT_BASE}${ENDPOINTS.starredRepos}`
          },
          {
            "@type": "DataDownload",
            "name": "Books JSON",
            "encodingFormat": "application/json",
            "contentUrl": `${CLOUDFRONT_BASE}${ENDPOINTS.books}`
          },
          {
            "@type": "DataDownload",
            "name": "Articles JSON",
            "encodingFormat": "application/json",
            "contentUrl": `${CLOUDFRONT_BASE}${ENDPOINTS.articles}`
          },
          {
            "@type": "DataDownload",
            "name": "Theatre reviews JSON",
            "encodingFormat": "application/json",
            "contentUrl": `${CLOUDFRONT_BASE}${ENDPOINTS.theatreReviews}`
          },
          {
            "@type": "DataDownload",
            "name": "Workouts JSON",
            "encodingFormat": "application/json",
            "contentUrl": `${CLOUDFRONT_BASE}${ENDPOINTS.workouts}`
          },
          {
            "@type": "DataDownload",
            "name": "Location JSON",
            "encodingFormat": "application/json",
            "contentUrl": `${CLOUDFRONT_BASE}${ENDPOINTS.location}`
          }
        ],
        "temporalCoverage": "2026-03-04/..",
        "inLanguage": "en-US"
      }
    ]
  })} />

  {/* Font preload (critical for swap timing)
     Dev note: Chrome warns "preloaded but not used within a few seconds" on localhost.
     This is a Vite dev-server timing artifact — the middleware stack delays CSS delivery
     enough for Chrome's ~3s timer to fire before @font-face claims the font. Harmless;
     does not occur in production where static files are served directly. */}
  <link rel="preload" href="/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" as="image" type="image/webp" href="/assets/avatar.webp">

  <link rel="preconnect" href={CLOUDFRONT_BASE} crossorigin>
  {import.meta.env.PROD && (
    <link rel="prefetch" href={`${CLOUDFRONT_BASE}${ENDPOINTS.health}`} as="fetch" crossorigin>
    <link rel="prefetch" href={`${CLOUDFRONT_BASE}${ENDPOINTS.sleep}`} as="fetch" crossorigin>
    <link rel="prefetch" href={`${CLOUDFRONT_BASE}${ENDPOINTS.focus}`} as="fetch" crossorigin>
    <link rel="prefetch" href={`${CLOUDFRONT_BASE}${ENDPOINTS.books}`} as="fetch" crossorigin>
    <link rel="prefetch" href={`${CLOUDFRONT_BASE}${ENDPOINTS.theatreReviews}`} as="fetch" crossorigin>
  )}
  <link rel="dns-prefetch" href="https://scripts.simpleanalyticscdn.com">
  <link rel="dns-prefetch" href="https://queue.simpleanalyticscdn.com">
  <link rel="stylesheet" href="/vendor/leaflet/leaflet.css" media="print" id="leafletCss">
  {/* Design system tokens: 3-line public contract (preamble + layered values + bare-name compat aliases).
       Astro processes this <style> (non-inline), resolves the @imports via @lifegames/tokens,
       and inlines the result at build time because astro.config.mjs sets build.inlineStylesheets: 'always'.
       LCP behavior is preserved vs the previous in-file :root token block. */}
  <style is:global>
    @import '@lifegames/tokens/preamble';
    @import '@lifegames/tokens/css.layered';
    @import '@lifegames/tokens/compat';
    @import '@lifegames/tokens/components';
    @import '@lifegames/tokens/effects';
    @import '@lifegames/tokens/reset';
    @import '@lifegames/web/styles/a11y.css';
  </style>
  {/* @font-face rules (Space Grotesk + Fallback) are provided by @lifegames/tokens/preamble
      (imported in the <style is:global> block above) — no duplication needed here. */}
  <style is:inline>/* ===== DESIGN TOKENS =====
   Sourced from @lifegames/tokens (imported via the <style> block above this
   <style is:inline> tag). All bare names (--neon-*, --glass-*, --text*,
   --font-size-*, --space-*, --radius-*, --blur-*, --glow-*) resolve via the
   compat layer; --lg-* names resolve from css.layered. Same hex values. */

/* ===== GLOBAL STYLES =====
   Reset is provided by @lifegames/tokens/reset (imported in the layered
   <style is:global> block above). A universal `* { margin: 0; padding: 0 }`
   reset MUST NOT be reintroduced here — un-layered styles win over layered
   styles at any specificity, and that would clobber `.right-panel`'s
   margin-left in tokens/layout.css, collapsing the dashboard layout. */

html, body {
  height: 100%;
  height: 100dvh;
  font-family: 'Space Grotesk', 'Space Grotesk Fallback', sans-serif;
  background: var(--bg);
  color: var(--text);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Lock viewport scroll only at widths where the bento grid is sized to
   fit 100dvh. Below 1100px the layout stacks vertically and MUST scroll. */
@media (min-width: 1100px) {
  html, body { overflow: hidden; }
}

/* Reading-feed items are inserted via body.innerHTML by the live-data
   updater. Chrome sometimes registers the declared CSS animation
   (animationPlayState=running) without ever scheduling an actual Web
   Animation instance, leaving items stuck at the `from` keyframe
   (opacity: 0). Force the resting state to opacity: 1 so items are
   visible when the animation never fires; the slide-in still plays
   when it does fire because the keyframe overrides during the run. */
.article-list-item { opacity: 1; }

/* ===== @SUPPORTS FALLBACKS ===== */
@supports not (backdrop-filter: blur(1px)) {
  .top-bar,
  .identity-card,
  .left-panel-status,
  .tri-card,
  .book-overlay,
  .book-modal {
    background: rgba(6, 6, 15, 0.95);
  }
}

@supports not (container-type: inline-size) {
  .tri-card {
    container-type: normal;
  }
}

/* ===== HIGH CONTRAST (WCAG 1.4.11) ===== */
@media (prefers-contrast: more) {
  :root {
    --glass-bg: rgba(0, 0, 0, 0.85);
    --glass-border: rgba(255, 255, 255, 0.3);
    --glass-border-strong: rgba(255, 255, 255, 0.5);
    --text-muted: #d1d5db;
  }
}

/* ===== FORCED COLORS (Windows High Contrast) ===== */
@media (forced-colors: active) {
  .tri-card,
  .identity-card,
  .left-panel-status,
  .book-modal {
    border: 2px solid CanvasText;
    background: Canvas;
    color: CanvasText;
    forced-color-adjust: none;
  }

  .live-dot,
  .sys-dot {
    background: Highlight;
    box-shadow: none;
  }

  .neon-pill {
    border: 1px solid LinkText;
    color: LinkText;
  }

  .lg-skip-link {
    background: Highlight;
    color: HighlightText;
  }
}

/* Three.js canvas */
#particle-canvas {
  position: fixed;
  inset: 0;
  z-index: 0;
  will-change: transform;
}

/* Focus indicators (.neon-pill, .shelf-book, .book-modal-close) are provided
   by @lifegames/tokens/reset (base.css lines 116-130) — no duplication here. */

/* Critical visibility — inlined to avoid LCP delay from deferred components.css */
.tri-card { opacity: 0; transform: translateY(20px); transition: opacity 0.6s ease, transform 0.6s ease; }
.tri-card.visible { opacity: 1; transform: translateY(0); }
.identity-card { opacity: 0; transform: translateX(-30px); transition: opacity 0.8s ease, transform 0.8s ease; }
.identity-card.visible { opacity: 1; transform: translateX(0); }
.left-panel-status { opacity: 0; transform: translateX(-30px); transition: opacity 0.8s ease, transform 0.8s ease; }
.left-panel-status.visible { opacity: 1; transform: translateX(0); }
.left-panel-bio { opacity: 0; transform: translateX(-30px); transition: opacity 0.8s ease, transform 0.8s ease; }
.left-panel-bio.visible { opacity: 1; transform: translateX(0); }</style>
  <style is:global>
    @import '@lifegames/tokens/layout';
  </style>
  {import.meta.env.PROD && <script is:inline src="/js/sa-stub.js"></script>}
</head>
<body>
  <div class="hud-frame" aria-hidden="true"></div>
  <noscript><style>.tri-card,.identity-card,.left-panel-status,.left-panel-bio{opacity:1!important;transform:none!important;}</style></noscript>
  <a href="#main-content" class="lg-skip-link">{identity.a11y.skipToMain}</a>
  <slot />
  {/* BookModal: externalized activation (CSP script-src 'self'). Delegated
       handler on document.body parses .shelf-book[data-book] JSON and opens the modal. */}
  <script is:inline src="/js/book-modal.js" defer></script>
  {/* IdentityCard social-click analytics: externalized delegated handler (CSP). */}
  <script is:inline src="/js/social-click-track.js" defer></script>
  {/* Leaflet: lazy-loaded via IntersectionObserver when a map widget scrolls into view */}
  <script is:inline src="/js/leaflet-lazy.js"></script>
  <script is:inline src="/js/sw-register.js"></script>
  {/* WebMCP: expose site tools to AI agents via browser (W3C Community Draft) */}
  <script is:inline src="/js/webmcp.js"></script>
  {import.meta.env.PROD && (
    <Fragment>
      <script is:inline src="/js/sa-loader.js"></script>
      <noscript><img src="https://queue.simpleanalyticscdn.com/noscript.gif" alt="" referrerpolicy="no-referrer-when-downgrade" /></noscript>
    </Fragment>
  )}
</body>
</html>
