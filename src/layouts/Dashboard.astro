---
import { getEntry } from 'astro:content';
import { CLOUDFRONT_BASE, LLM_CONTENT_PATHS, DATASET_VARIABLES, DATASET_DISTRIBUTIONS } from '@j0nathan-ll0yd/portal-contract/constants';
import { LLMS_TXT_PATH } from '../lib/edge/llms-artifacts';
import { SITE_LOGO, SITE_PAGE_PATHS, SITEMAP_INDEX_PATH } from '../lib/edge/site-paths';
import { llm } from '@j0nathan-ll0yd/copy';
const _identityEntry = await getEntry('copy', 'identity');
if (!_identityEntry) throw new Error('[Dashboard.astro] @j0nathan-ll0yd/copy identity entry missing — check the @j0nathan-ll0yd/copy install and content.config.ts');
const identity = _identityEntry.data;
const {
  title = identity.seo.title,
  description = identity.person.shortBio,
  ogDescription = identity.person.socialBio,
  robots = 'index, follow',
  // A data-free page (/offline) carries no live-data plumbing at all: no CloudFront preconnect,
  // no WebMCP tools (they read gated data), no analytics and no JSON-LD graph. The service worker
  // serves it from its precache with no network (atlas decision 0160, PR 0b;
  // openspec/specs/client-privacy).
  dataFree = false,
  // schema.org type of this page's WebPage node: AboutPage, ContactPage, or plain WebPage.
  pageType = 'WebPage',
} = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, '');
// build.format 'file' puts the output file name in Astro.url.pathname at build time
// (/privacy.html, /index.html). The page's URL drops it: the host serves privacy.html at /privacy.
const pagePath = Astro.url.pathname.replace(/(?:\/index)?\.html$/, '') || '/';
const canonicalURL = siteUrl + (pagePath === '/' ? '' : pagePath);
const ogImage = new URL('/assets/og-image.png', Astro.site);
// Cloudflare Web Analytics site token (public — appears in the page markup). The
// beacon is served first-party via /cf-insights.js; see the tag before </body>.
const CF_BEACON_TOKEN = '4816323971ac433eb5450e8b0534acfc';

// --- JSON-LD @graph ---------------------------------------------------------
// Dashboard.astro is the layout for /, the text pages and /404 alike. Only the home
// page is a person's profile page and the live datastream, so ProfilePage and
// Dataset are gated to it; other pages emit a plain WebPage instead. WebSite and
// the full Person are site-wide entities and appear on every page (WebSite is
// slimmed on non-home pages so the full node is not repeated per page).
const isHome = pagePath === '/';

// No dateModified on the ProfilePage: Google lists it as recommended "if
// applicable", and no verifiable edit date exists for the profile content. It
// comes from @j0nathan-ll0yd/copy, which was yalc-linked (no version) when a
// date was last hand-set and has since moved to a registry version. Same
// omit-when-unverifiable rule as the sitemap lastmod. tests/build/json-ld.test.ts
// fails if a dateModified returns.

const websiteId = siteUrl + '#website';
const personId = siteUrl + '#person';
const organizationId = siteUrl + '#organization';
const contactUrl = new URL(SITE_PAGE_PATHS.contact, Astro.site).href;

// The organization's contact alias and PO Box (owner rulings 2026-10-24, reversing atlas decision
// 0158 O5). The alias is a purpose-made, revocable address, not the personal one, which stays
// obfuscated on /contact; scripts/check-no-clear-email.mjs admits this one address in this block
// only. The Person carries the same alias and the same mailing address.
const organizationEmail = identity.organization.contactEmail;
const poBoxAddress = {
  '@type': 'PostalAddress',
  postOfficeBoxNumber: identity.organization.poBox,
  addressLocality: identity.organization.locality,
  addressRegion: identity.organization.region,
  postalCode: identity.organization.postalCode,
  addressCountry: identity.organization.country,
};

// First in every @graph: a checker that takes the first Organization, or walks WebSite.publisher,
// lands here rather than on the nested employer or university.
const organizationNode = {
  '@type': 'Organization',
  '@id': organizationId,
  name: identity.organization.name,
  url: siteUrl,
  logo: {
    '@type': 'ImageObject',
    url: new URL(SITE_LOGO.path, Astro.site).href,
    width: SITE_LOGO.width,
    height: SITE_LOGO.height,
  },
  description: identity.organization.description,
  // NAICS 541511 (Custom Computer Programming Services): the description is its title.
  naics: '541511',
  founder: { '@id': personId },
  member: { '@id': personId },
  sameAs: identity.person.sameAs,
  email: organizationEmail,
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: identity.organization.contactType,
      email: organizationEmail,
      url: contactUrl,
      availableLanguage: 'en',
    },
  ],
  address: poBoxAddress,
};

// Real avatar (200x200), preloaded in the head. Distinct from the 1200x630 OG
// card, which stays reserved for og:image social embeds.
const avatarImage = {
  '@type': 'ImageObject',
  url: new URL('/assets/avatar.webp', Astro.site).toString(),
  width: 200,
  height: 200,
  caption: identity.a11y.ogImageAlt,
};

const personNode = {
  '@type': 'Person',
  '@id': personId,
  name: identity.person.name,
  alternateName: identity.person.handle,
  givenName: identity.person.firstName,
  familyName: identity.person.lastName,
  jobTitle: identity.person.jobTitle,
  url: siteUrl,
  image: avatarImage,
  sameAs: identity.person.sameAs,
  // The organization's alias, never the personal address (identity.person.email), which appears
  // in clear in no page (atlas decision 0158, owner ruling 2026-10-15).
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: identity.person.contactType,
    email: organizationEmail,
    url: contactUrl,
  },
  address: poBoxAddress,
  memberOf: { '@id': organizationId },
  knowsAbout: identity.seo.expertise,
  worksFor: {
    '@type': 'Organization',
    name: identity.person.employer,
    url: identity.person.employerUrl,
  },
  alumniOf: {
    '@type': 'EducationalOrganization',
    name: identity.person.alumniOf,
    url: identity.person.alumniOfUrl,
  },
  knowsLanguage: ['en-US'],
  disambiguatingDescription: identity.person.shortBio,
  description: identity.person.longBio,
};

const websiteFull = {
  '@type': 'WebSite',
  '@id': websiteId,
  name: identity.site.fullName,
  alternateName: identity.site.name,
  description: identity.site.description,
  url: siteUrl,
  inLanguage: 'en-US',
  image: { '@type': 'ImageObject', url: ogImage.toString() },
  publisher: { '@id': organizationId },
};

// Slim WebSite for non-home pages: identity only, so the full WebSite node is not
// duplicated on every page. WebPage.isPartOf still resolves against this @id.
const websiteSlim = {
  '@type': 'WebSite',
  '@id': websiteId,
  name: identity.site.fullName,
  url: siteUrl,
};

const profilePageNode = {
  '@type': 'ProfilePage',
  '@id': siteUrl + '#profilepage',
  name: `About ${identity.person.name}`,
  isPartOf: { '@id': websiteId },
  mainEntity: { '@id': personId },
  url: canonicalURL.toString(),
  dateCreated: '2026-03-04T00:00:00Z',
  inLanguage: 'en-US',
};

const datasetNode = {
  '@type': 'Dataset',
  '@id': siteUrl + '#datastream',
  name: identity.site.name,
  description: llm.dashboard.datasetDescription,
  creator: { '@id': personId },
  publisher: { '@id': organizationId },
  license: new URL(SITE_PAGE_PATHS.privacy, Astro.site).href,
  isAccessibleForFree: true,
  variableMeasured: [...DATASET_VARIABLES],
  distribution: DATASET_DISTRIBUTIONS.map((d) => ({
    '@type': 'DataDownload',
    name: d.name,
    encodingFormat: d.encodingFormat,
    contentUrl: d.contentUrl,
  })),
  temporalCoverage: '2026-03-04/..',
  inLanguage: 'en-US',
};

const webPageNode = {
  '@type': pageType,
  '@id': canonicalURL.toString() + '#webpage',
  isPartOf: { '@id': websiteId },
  name: title,
  inLanguage: 'en-US',
};

const jsonLdGraph = isHome
  ? [organizationNode, websiteFull, profilePageNode, personNode, datasetNode]
  : [organizationNode, websiteSlim, webPageNode, personNode];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  {/* First script on the page and deferred: agent scanners read only the first few
      scripts for WebMCP registrations, and defer keeps it off the critical path. */}
  {!dataFree && <script is:inline src="/js/webmcp.js" defer></script>}
  <meta name="theme-color" content="#06060f">
  <meta name="color-scheme" content="dark">
  <meta name="description" content={description}>
  <meta name="robots" content={robots}>
  <meta name="keywords" content={identity.seo.keywords.join(', ')}>
  {/* CSP and Referrer-Policy are response headers, so no equivalent meta tags belong here. */}
  <meta name="author" content={identity.person.name}>
  <meta property="og:locale" content="en_US">
  <link rel="canonical" href={canonicalURL}>
  {/* Both alternates address the SITE plane, never the CloudFront origin. The privacy
      gate and the cache rules live on the site plane (src/lib/edge/proxy.ts); an
      advertised origin URL inherits none of that policy and the origin serves
      selectively. They describe the homepage datastream, so they are gated to it. */}
  {isHome && (
    <>
      <link rel="alternate" type="text/markdown" href={`${siteUrl}${LLM_CONTENT_PATHS.llmsFull}`} title={llm.dashboard.alternateLinkMarkdown}>
      <link rel="alternate" type="text/plain" href={`${siteUrl}${LLMS_TXT_PATH}`} title={llm.dashboard.alternateLinkPlain}>
    </>
  )}
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="apple-touch-icon" href="/assets/icon-192.png">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="sitemap" href={SITEMAP_INDEX_PATH}>
  <link rel="author" href="/humans.txt">
  <link rel="privacy-policy" href={SITE_PAGE_PATHS.privacy}>
  <link rel="alternate" type="application/rss+xml" title={identity.feed.title} href="/feed.xml">
  <link rel="alternate" type="application/feed+json" title={identity.feed.title} href="/feed.json">

  <meta property="og:title" content={title}>
  <meta property="og:description" content={ogDescription}>
  <meta property="og:type" content="profile">
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={identity.a11y.ogImageAlt}>
  <meta property="og:site_name" content={identity.site.name}>
  <meta property="profile:first_name" content={identity.person.firstName}>
  <meta property="profile:last_name" content={identity.person.lastName}>

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={ogDescription}>
  <meta name="twitter:image" content={ogImage}>
  <meta name="twitter:image:alt" content={identity.a11y.ogImageAlt}>

  {!dataFree && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": jsonLdGraph
    })} />
  )}

  {/* This preload must match tokens/fonts to avoid a swap-induced layout shift. */}
  <link rel="preload" href="/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin>
  {!dataFree && <link rel="preload" as="image" type="image/webp" href="/assets/avatar.webp">}

  {/* No gated-JSON prefetch (atlas decision 0160, PR 0b). A prefetch stores the export in the
      browser HTTP cache for minutes, after the owner may have hidden it, and the client never reads
      that copy: every runtime read is `cache: 'no-store'` (src/lib/runtime/api.ts). The preconnect
      keeps the connection warm without storing any data. */}
  {!dataFree && <link rel="preconnect" href={CLOUDFRONT_BASE} crossorigin>}
  {import.meta.env.DEV && <link rel="stylesheet" href="/vendor/leaflet/leaflet.css" media="print" id="leafletCss">}
  {/* Keep this style processed so Astro resolves package imports and inlines them at build time. */}
  <style is:global>
    @import '@j0nathan-ll0yd/tokens/preamble';
    @import '@j0nathan-ll0yd/tokens/fonts';
    @import '@j0nathan-ll0yd/tokens/css.layered';
    @import '@j0nathan-ll0yd/tokens/compat';
    @import '@j0nathan-ll0yd/web/styles/components.css';
    @import '@j0nathan-ll0yd/tokens/effects';
    @import '@j0nathan-ll0yd/tokens/reset';
    @import '@j0nathan-ll0yd/web/styles/a11y.css';
    @import '@j0nathan-ll0yd/web/styles/view-transitions.css';
  </style>
  <style is:inline>/* ===== DESIGN TOKENS =====
   Sourced from @j0nathan-ll0yd/tokens (imported via the <style> block above this
   <style is:inline> tag). All bare names (--neon-*, --glass-*, --text*,
   --font-size-*, --space-*, --radius-*, --blur-*, --glow-*) resolve via the
   compat layer; --lg-* names resolve from css.layered. Same hex values. */

/* ===== GLOBAL STYLES =====
   Reset is provided by @j0nathan-ll0yd/tokens/reset (imported in the layered
   <style is:global> block above). A universal `* { margin: 0; padding: 0 }`
   reset MUST NOT be reintroduced here — un-layered styles win over layered
   styles at any specificity, and that would clobber `.right-panel`'s
   margin-left in tokens/layout.css, collapsing the dashboard layout. */

/* px/% fallback for the ~5% pre-dvh browser tail; dvh refines for the rest */
html, body {
  height: 100%;
  height: 100dvh;
  font-family: 'Space Grotesk', 'Space Grotesk Fallback', sans-serif;
  background: var(--bg);
  color: var(--text);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Prevent layout shift from scrollbar appearing/disappearing.
   @supports guards against the open Chromium bug with both-edges (omitted). */
html { overflow-y: scroll; }
@supports (scrollbar-gutter: stable) { html { overflow-y: auto; scrollbar-gutter: stable; } }

/* Lock viewport scroll only at widths where the bento grid is sized to
   fit 100dvh. At 1100px and below the layout stacks vertically and MUST scroll:
   the design system's tablet block (layout.css, max-width: 1100px) stacks it at
   1100px itself, so the lock starts above that. */
@media (min-width: 1101px) {
  html, body { overflow: hidden; }
}

/* Reading-feed items are inserted via body.innerHTML by the live-data
   updater. Chrome sometimes registers the declared CSS animation
   (animationPlayState=running) without ever scheduling an actual Web
   Animation instance, leaving items stuck at the `from` keyframe
   (opacity: 0). Force the resting state to opacity: 1 so items are
   visible when the animation never fires; the slide-in still plays
   when it does fire because the keyframe overrides during the run. */
.article-list-item { opacity: 1; }

/* ===== @SUPPORTS FALLBACKS ===== */
@supports not (backdrop-filter: blur(1px)) {
  .top-bar,
  .identity-card,
  .left-panel-status,
  .tri-card,
  dialog.book-dialog::backdrop,
  .book-modal {
    background: rgba(6, 6, 15, 0.95);
  }
}

@supports not (container-type: inline-size) {
  .tri-card {
    container-type: normal;
  }
}

/* ===== HIGH CONTRAST (WCAG 1.4.11) ===== */
@media (prefers-contrast: more) {
  :root {
    --glass-bg: rgba(0, 0, 0, 0.85);
    --glass-border: rgba(255, 255, 255, 0.3);
    --glass-border-strong: rgba(255, 255, 255, 0.5);
    --text-muted: #d1d5db;
  }
}

/* ===== FORCED COLORS (Windows High Contrast) ===== */
@media (forced-colors: active) {
  .tri-card,
  .identity-card,
  .left-panel-status,
  .book-modal {
    border: 2px solid CanvasText;
    background: Canvas;
    color: CanvasText;
    forced-color-adjust: none;
  }

  .live-dot,
  .sys-dot {
    background: Highlight;
    box-shadow: none;
  }

  .neon-pill {
    border: 1px solid LinkText;
    color: LinkText;
  }

  .lg-skip-link {
    background: Highlight;
    color: HighlightText;
  }
}

/* Three.js canvas */
#particle-canvas {
  position: fixed;
  inset: 0;
  z-index: 0;
  will-change: transform;
}

/* Focus indicators (.neon-pill, .shelf-book, .book-modal-close) are provided
   by @j0nathan-ll0yd/tokens/reset (base.css lines 116-130) — no duplication here. */

/* Critical visibility — inlined to avoid LCP delay from deferred components.css */
.tri-card { opacity: 0; transform: translateY(20px); transition: opacity 0.6s ease, transform 0.6s ease; }
.tri-card.visible { opacity: 1; transform: translateY(0); }
.identity-card { opacity: 0; transform: translateX(-30px); transition: opacity 0.8s ease, transform 0.8s ease; }
.identity-card.visible { opacity: 1; transform: translateX(0); }
.left-panel-status { opacity: 0; transform: translateX(-30px); transition: opacity 0.8s ease, transform 0.8s ease; }
.left-panel-status.visible { opacity: 1; transform: translateX(0); }
.left-panel-bio { opacity: 0; transform: translateX(-30px); transition: opacity 0.8s ease, transform 0.8s ease; }
.left-panel-bio.visible { opacity: 1; transform: translateX(0); }
/* Reveal fallback (decision 0157 O2b): card-reveal.js adds .visible. If it fails to load or run,
   an element that never gets .visible still fades in after 2.5 s. .visible ends the animation and
   the transitions above run as before. */
@keyframes reveal-fallback { to { opacity: 1; transform: none; } }
.tri-card:not(.visible), .identity-card:not(.visible), .left-panel-status:not(.visible), .left-panel-bio:not(.visible) { animation: reveal-fallback 0.6s ease 2.5s forwards; }
@media (prefers-reduced-motion: reduce) {
  .tri-card:not(.visible), .identity-card:not(.visible), .left-panel-status:not(.visible), .left-panel-bio:not(.visible) { animation-duration: 0.01s; }
}</style>
  <style is:global>
    @import '@j0nathan-ll0yd/web/styles/layout.css';
  </style>
  {import.meta.env.PROD && !dataFree && <script is:inline src="/js/sa-stub.js"></script>}
</head>
<body>
  <div class="hud-frame" aria-hidden="true"></div>
  <noscript><style>.tri-card,.identity-card,.left-panel-status,.left-panel-bio{opacity:1!important;transform:none!important;}</style></noscript>
  <a href="#main-content" class="lg-skip-link">{identity.a11y.skipToMain}</a>
  <slot />
  {/* The delegated analytics handler stays external to satisfy CSP. */}
  {import.meta.env.PROD && !dataFree && <script is:inline src="/js/social-click-track.js" defer></script>}
  {/* Defer Leaflet until a map enters view to avoid its initial-load cost. */}
  {import.meta.env.DEV && <script is:inline src="/js/leaflet-lazy.js"></script>}
  <script is:inline src="/js/sw-register.js"></script>
  {import.meta.env.PROD && !dataFree && (
    <Fragment>
      <script is:inline src="/js/sa-loader.js"></script>
      <noscript><img src="/simple/noscript.gif" alt="" referrerpolicy="no-referrer-when-downgrade" /></noscript>
    </Fragment>
  )}
  {/* Proxy script and RUM traffic first-party to avoid Safari's tracker blocklist.
      Cloudflare auto-injection must stay disabled or it restores the third-party beacon. */}
  {import.meta.env.PROD && !dataFree && (
    <script
      is:inline
      defer
      src="/cf-insights.js"
      data-cf-beacon={JSON.stringify({ token: CF_BEACON_TOKEN, send: { to: '/cf-rum' } })}
    />
  )}
</body>
</html>
