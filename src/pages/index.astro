---
import DashboardHome from '../layouts/DashboardHome.astro';
import { loadDashboardData } from '../lib/load-dashboard-data';

// The data-free page (atlas decision 0160, PR 0a), prerendered. Only authored identity content is
// real; every live widget renders `loading` with its <noscript> note, and live-data.ts fills it
// after load. Since PR B the Worker answers `GET /` with a server render
// (src/pages/ssr-dashboard.astro) and serves this file only when that render misses its budget,
// for `HEAD /`, and after a rollback (D9).
---
<DashboardHome data={loadDashboardData()} />
