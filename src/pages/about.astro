---
import { getEntry } from 'astro:content';
import { TextPageSection } from '@j0nathan-ll0yd/web/components';
import InfoPage from '../layouts/InfoPage.astro';
import { SITE_PAGE_PATHS } from '../lib/edge/site-paths';

const _identityEntry = await getEntry('copy', 'identity');
if (!_identityEntry) throw new Error('[about.astro] @j0nathan-ll0yd/copy identity entry missing');
const id = _identityEntry.data;
const a = id.about;

const sections = [
  { heading: a.backgroundHeading, body: id.person.longBio },
  { heading: a.workHeading, body: a.work },
  { heading: a.siteHeading, body: a.site },
  { heading: a.outsideHeading, body: a.outside },
];
---
<InfoPage title={a.title} description={a.metaDescription} path={SITE_PAGE_PATHS.about} pageType="AboutPage">
  {sections.map((s) => (
    <TextPageSection heading={s.heading}>
      <p>{s.body}</p>
    </TextPageSection>
  ))}
</InfoPage>
