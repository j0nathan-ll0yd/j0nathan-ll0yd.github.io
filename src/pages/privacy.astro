---
import { getEntry } from 'astro:content';
import { TextPageSection } from '@j0nathan-ll0yd/web/components';
import InfoPage from '../layouts/InfoPage.astro';
import { SITE_PAGE_PATHS } from '../../functions/_lib/site-paths';

const _identityEntry = await getEntry('copy', 'identity');
if (!_identityEntry) throw new Error('[privacy.astro] @j0nathan-ll0yd/copy identity entry missing');
const p = _identityEntry.data.privacy;

const sections = [
  { heading: p.whoHeading, body: p.who },
  { heading: p.dataDisplayedHeading, body: p.dataDisplayed },
  { heading: p.dataCollectedHeading, body: p.dataCollected },
  { heading: p.analyticsHeading, body: p.analytics },
  { heading: p.rightsHeading, body: p.rights },
  { heading: p.changesHeading, body: p.changes },
];
---
<InfoPage
  title={p.title}
  description={p.dataCollected}
  path={SITE_PAGE_PATHS.privacy}
  robots="noindex, follow"
  updated={{ label: p.lastUpdatedLabel, date: p.lastUpdated, datetime: p.lastModified }}
>
  {/* Content-use preferences are carried by the HTTP Content-Usage response header; robots.txt stays RFC 9309-only. */}
  {sections.map((s) => (
    <TextPageSection heading={s.heading}>
      <p>{s.body}</p>
    </TextPageSection>
  ))}
</InfoPage>
