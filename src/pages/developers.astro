---
import { SITE_URL } from '@j0nathan-ll0yd/portal-contract/constants';
import { llm } from '@j0nathan-ll0yd/copy';
import { TextPageSection } from '@j0nathan-ll0yd/web/components';
import InfoPage from '../layouts/InfoPage.astro';
import { AGENT_PATHS } from '../lib/edge/agent-paths.mjs';
import { API_PROBLEMS, API_V1_BASE, DATA_SOURCES, TOOLS, fillTemplate } from '../lib/edge/agent-catalog.mjs';
import { linkSegments } from '../lib/link-segments';

const d = llm.developers;
const site = (template: string) => fillTemplate(template, 'siteUrl', SITE_URL);
// The bare API base answers the not-found problem, so prose names it without a link.
// Each problem type is a level-3 heading in the text page's label-and-note list form, so the
// design system's list rules style it; its id is the fragment of the problem's `type` URI.
const linkable = (href: string | undefined) => (href === API_V1_BASE ? undefined : href);

type Item = { name: string; href?: string; note: string };
type Problem = { anchor: string; status: number; title: string; detail: string };
type Section = { id: string; heading: string; body: string[]; items?: Item[]; problems?: readonly Problem[] };

const sections: Section[] = [
  {
    id: 'api',
    heading: d.apiHeading,
    body: [site(d.apiBody), site(d.apiBaseNote)],
    items: DATA_SOURCES.map((s) => ({ name: s.name, href: s.apiUrl, note: s.description })),
  },
  { id: 'errors', heading: d.errorsHeading, body: [d.errorsBody], problems: API_PROBLEMS },
  { id: 'versioning', heading: d.versioningHeading, body: [d.versioningBody] },
  { id: 'rate-limits', heading: d.rateLimitHeading, body: [d.rateLimitBody] },
  { id: 'mcp', heading: d.mcpHeading, body: [site(d.mcpBody)] },
  { id: 'webmcp', heading: d.webmcpHeading, body: [d.webmcpBody], items: TOOLS.map((t) => ({ name: t.name, note: t.description })) },
  { id: 'llms', heading: d.llmsHeading, body: [site(d.llmsBody)] },
  { id: 'feeds', heading: d.feedsHeading, body: [site(d.feedsBody)] },
  { id: 'caching', heading: d.cachingHeading, body: [d.cachingBody] },
  { id: 'focus', heading: d.focusHeading, body: [d.focusBody] },
  { id: 'usage', heading: d.usageHeading, body: [d.usageBody] },
];
---
<InfoPage title={d.title} description={d.metaDescription} path={AGENT_PATHS.developers} lede={d.intro}>
  {sections.map((s) => (
    <TextPageSection heading={s.heading} id={s.id}>
      {s.body.map((paragraph) => (
        <p>
          {linkSegments(paragraph).map((seg) => (linkable(seg.href) ? <a href={seg.href}>{seg.text}</a> : seg.text))}
        </p>
      ))}
      {s.items && (
        <ul>
          {s.items.map((item) => (
            <li>
              {item.href ? <a href={item.href}>{item.name}</a> : <code>{item.name}</code>}
              <small>{item.note}</small>
            </li>
          ))}
        </ul>
      )}
      {s.problems && (
        <ul>
          {s.problems.map((problem) => (
            <li>
              <b id={problem.anchor} role="heading" aria-level="3">
                <code>{problem.status}</code> {problem.title}
              </b>
              <small>{linkSegments(problem.detail).map((seg) => (linkable(seg.href) ? <a href={seg.href}>{seg.text}</a> : seg.text))}</small>
            </li>
          ))}
        </ul>
      )}
    </TextPageSection>
  ))}
</InfoPage>
