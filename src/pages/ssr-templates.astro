---
// Card templates for the edge injection (atlas decision 0160, PR B; owner decision 2026-10-16,
// option B). The design system's components stay the only source of widget markup: the build renders
// each live card here, and the Worker swaps the matching template in for the card of the data-free
// page, then writes the real values into its slots (src/lib/edge-render/).
//
// - `<card>:empty|unavailable|suppressed`: the states that show no value, rendered with no data.
// - `<card>:live|stale|stale-untimed[...]`: the data states, rendered from value-free stand-in props
//   (src/lib/edge-render/slot-props.ts), so each slot shows its element, attributes and padding.
// - `cardBooks:item-*`: one template per shelf-item shape.
//
// No export or fixture value can reach this file. The Worker reads it through the ASSETS binding; a
// public request for its path gets the 404 page (src/worker.ts).
import {
  Bookshelf, DevActivityLog, HeartRate, Hydration, MovementRings, NightSummary,
  ReadingFeed, StarredRepoList, TheatreReviews, Workouts,
} from '@j0nathan-ll0yd/web/production';
import { MIRRORED_BOOK_COVERS } from '../lib/load-dashboard-data';
import { TEMPLATE_ATTRIBUTE } from '../lib/edge-render/paths';
import { TEMPLATE_STATES } from '../lib/edge-render/templates';
import {
  bookshelfSlotProps, DATA_VARIANTS, heartRateSlotProps, SHELF_ITEM_SHAPES, shelfItemKey, theatreSlotProps,
} from '../lib/edge-render/slot-props';

const localCovers = [...MIRRORED_BOOK_COVERS];
const cards = [
  { id: 'cardHR', Component: HeartRate },
  { id: 'cardMovement', Component: MovementRings },
  { id: 'cardHydration', Component: Hydration },
  { id: 'cardSleep', Component: NightSummary },
  { id: 'cardWorkouts', Component: Workouts },
  { id: 'cardDevLog', Component: DevActivityLog },
  { id: 'cardReading', Component: ReadingFeed },
  { id: 'cardStarredRepos', Component: StarredRepoList },
  { id: 'cardBooks', Component: Bookshelf },
  { id: 'cardTheatreReviews', Component: TheatreReviews },
];
const key = (value: string) => ({ [TEMPLATE_ATTRIBUTE]: value });
---
<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="robots" content="noindex, nofollow"><title>templates</title></head>
<body>
{cards.map(({ id, Component }) => TEMPLATE_STATES.map((state) => (
  <template {...key(`${id}:${state}`)}>{id === 'cardBooks' ? <Component state={state} localCovers={localCovers} /> : <Component state={state} />}</template>
)))}
{DATA_VARIANTS.map((variant) => (
  <>
    <template {...key(`cardHR:${variant}`)}><HeartRate {...heartRateSlotProps(variant, false)} /></template>
    <template {...key(`cardHR:${variant}-paused`)}><HeartRate {...heartRateSlotProps(variant, true)} /></template>
    <template {...key(`cardTheatreReviews:${variant}`)}><TheatreReviews {...theatreSlotProps(variant)} /></template>
    <template {...key(`cardBooks:${variant}`)}><Bookshelf {...bookshelfSlotProps(variant)} localCovers={localCovers} /></template>
  </>
))}
{SHELF_ITEM_SHAPES.map((shape) => (
  <template {...key(`cardBooks:${shelfItemKey(shape)}`)}><Bookshelf {...bookshelfSlotProps('live', shape)} localCovers={localCovers} /></template>
))}
</body>
</html>
