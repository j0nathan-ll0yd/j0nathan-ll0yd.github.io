              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Suppressed"
          }
        }
      }
    },
    "/github-events.json": {
      "get": {
        "operationId": "getGithubEvents",
        "summary": "GitHub activity",
        "description": "Dev activity, languages, contributions, and recent commits",
        "responses": {
          "200": {
            "description": "Dev activity, languages, contributions, and recent commits",
