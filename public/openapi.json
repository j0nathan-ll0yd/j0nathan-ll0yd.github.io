            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri-reference"
          },
          "validPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "retryAfterSeconds": {
            "type": "integer",
            "minimum": 0
          },
          "suppressed": {
            "const": true
          },
          "reason": {
            "type": "string"
          }
        }
      }
