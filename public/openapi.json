      "NotFound": {
        "description": "Not found",
        "headers": {
          "RateLimit-Policy": {
            "$ref": "#/components/headers/RateLimit-Policy"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/Problem"
                },
                {
                  "required": [
                    "validPaths"
                  ]
                }
              ]
            }
          }
        }
      },
      "MethodNotAllowed": {
        "description": "Method not allowed",
