{
  "openapi": "3.1.0",
  "info": {
    "title": "Jonathan Lloyd — Human Datastream",
    "version": "1.0.0",
    "description": "Summarised biometric and cognitive metrics for Jonathan Lloyd, composed on data-change events by a backend Lambda and served as LLM-optimized markdown alongside canonical JSON."
  },
  "servers": [
    {
      "url": "https://d1pfm520aduift.cloudfront.net"
    }
  ],
  "paths": {
    "/health.json": {
      "get": {
        "operationId": "getHealth",
        "summary": "Health biometrics",
        "description": "Heart rate, HRV, activity, and workout data (latest export, summarised)",
        "responses": {
          "200": {
            "description": "Heart rate, HRV, activity, and workout data (latest export, summarised)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthExport"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Suppressed"
          }
        }
      }
    },
    "/sleep.json": {
      "get": {
        "operationId": "getSleep",
        "summary": "Sleep data",
        "description": "Sleep phases, duration, and efficiency metrics",
        "responses": {
          "200": {
            "description": "Sleep phases, duration, and efficiency metrics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SleepExport"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Suppressed"
          }
        }
      }
    },
    "/workouts.json": {
      "get": {
        "operationId": "getWorkouts",
        "summary": "Workouts",
        "description": "Workout sessions with type, duration, and calorie burn",
        "responses": {
          "200": {
            "description": "Workout sessions with type, duration, and calorie burn",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkoutsExport"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Suppressed"
          }
        }
      }
    },
    "/books.json": {
      "get": {
        "operationId": "getBooks",
        "summary": "Bookshelf",
        "description": "Books with status, ratings, progress, and cover images",
        "responses": {
          "200": {
            "description": "Books with status, ratings, progress, and cover images",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BooksExport"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Suppressed"
          }
        }
      }
    },
    "/github-starred-repos.json": {
      "get": {
        "operationId": "getStarredRepos",
        "summary": "Starred repositories",
        "description": "GitHub starred repositories with metadata",
        "responses": {
          "200": {
            "description": "GitHub starred repositories with metadata",
