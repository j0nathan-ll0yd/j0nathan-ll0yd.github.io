{
  "name": "human-datastream",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "check:contract-lock": "node scripts/check-contract-lock.mjs",
    "doctor:install": "node scripts/doctor-install.mjs",
    "dev": "astro dev",
    "generate:webmcp": "node scripts/generate-webmcp.mjs",
    "prebuild": "npm run generate:webmcp && LIFEGAMES_VALIDATE_CWD=$PWD npx tsx node_modules/@j0nathan-ll0yd/schemas/scripts/validate.ts && npm run audit:fixtures && npm run audit:inline-scripts && npm run audit:sa-path",
    "audit:fixtures": "node scripts/audit-fixtures.mjs",
    "audit:inline-scripts": "node scripts/audit-inline-scripts.mjs",
    "audit:sa-path": "node scripts/check-sa-proxy-path.mjs",
    "audit:spec-verification": "node scripts/audit/check-spec-verification.mjs",
    "build": "astro build",
    "postbuild": "node scripts/check-live-data-bundle.mjs && node scripts/check-sw-precache.mjs && node scripts/write-version.mjs",
    "preview": "astro preview",
    "fetch:images": "node scripts/fetch-images.mjs",
    "test": "npm run test:unit && npm run test:build",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:build": "vitest run --config vitest.build.config.ts",
    "test:visual": "./scripts/run-in-docker.sh playwright.config.ts",
    "test:visual:update": "./scripts/run-in-docker.sh playwright.config.ts --update-snapshots --workers=1",
    "test:smoke": "npx playwright test --config=playwright.smoke.config.ts",
    "test:behavioral": "./scripts/run-in-docker.sh playwright.behavioral.config.ts",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint": "eslint .",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@j0nathan-ll0yd/copy": "^1.0.0",
    "@j0nathan-ll0yd/fixtures": "^1.0.3",
    "@j0nathan-ll0yd/portal-contract": "^1.0.0",
    "@j0nathan-ll0yd/schemas": "^2.0.0",
    "@j0nathan-ll0yd/tokens": "^2.0.0",
    "@j0nathan-ll0yd/web": "^2.0.0",
    "astro": "^7.1.3",
    "fast-xml-validator": "^1.4.0"
  },
  "overrides": {
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.3",
    "@j0nathan-ll0yd/config": "^1.1.0",
    "@lhci/cli": "^0.15.1",
    "@napi-rs/image": "1.14.0",
    "@playwright/test": "^1.60.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@vite-pwa/astro": "^1.2.0",
    "ajv": "^8.20.0",
    "cheerio": "^1.2.0",
    "dprint": "^0.55.1",
    "eslint": "^10.7.0",
    "fast-xml-parser": "^5.10.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "pa11y-ci": "^4.1.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "robots-parser": "^3.0.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.8",
    "wrangler": "^4.98.0"
  }
}
