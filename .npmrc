# @vite-pwa/astro (<=1.2.0) caps its astro peer at ^5 while this project is on
# astro 7 — fresh installs ERESOLVE without this. CI and the Docker visual
# harness already pass --legacy-peer-deps explicitly (.github/workflows/
# visual-tests.yml, scripts/run-in-docker.sh); this makes plain `npm ci` /
# `npm install` behave identically. This is the STANDING state, not a soon-to-be-
# removed patch: @vite-pwa/astro's published peer range never covered astro 6
# either. The astro 7 (vite 8) upgrade also needs the package.json `overrides`
# pin of vite-plugin-pwa ^1.3.0 (adds vite-8 peer support); the wrapper's build
# hooks were verified to still populate the SW precache manifest under vite 8 /
# rolldown (scripts/check-sw-precache.mjs is the standing guard). Drop both
# workarounds only once @vite-pwa/astro publishes an astro-7 peer range.
legacy-peer-deps=true

# @j0nathan-ll0yd/config (dprint/tsconfig/eslint standard) is published to
# GitHub Packages. npm expands ${GITHUB_TOKEN} from the environment (unlike
# pnpm), so CI authenticates with the workflow token in env and local installs
# fall through to the token in the developer's machine ~/.npmrc.
@j0nathan-ll0yd:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
