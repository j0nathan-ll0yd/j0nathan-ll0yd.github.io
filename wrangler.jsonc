// Cloudflare Worker for jonathanlloyd.me (atlas decision 0160, PR A; plan Step 3.1).
// `astro build` (@astrojs/cloudflare) reads this file and writes the deployable config to
// dist/server/wrangler.json; `wrangler deploy` and `wrangler versions upload` read that one.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "human-datastream",
  "main": "./src/worker.ts",
  // ONE runtime for every environment. Pages ran production on 2026-05-06 with no flags and
  // previews on 2026-06-10 with nodejs_compat, so a preview did not prove production. This keeps
  // the production date, at or after 2024-11-11 (the fetch `cache` option), and adds the flag the
  // plan names. tests/unit/worker-routing.test.ts pins both.
  "compatibility_date": "2026-05-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    // The default: `/x` serves x.html, and `/x.html` and `/x/` redirect to `/x`.
    "html_handling": "auto-trailing-slash",
    // An unmatched path runs the Worker, which renders the 404 page through the site middleware.
    "not_found_handling": "none",
    // Every path that runs code, and nothing else (plan Step 0.5 table). The first seven carry a
    // header the middleware sets beyond `_headers` (HEADER_OVERRIDE_PATHS); `/` also negotiates
    // Markdown. Then the routes in src/lib/edge/routes.ts EDGE_ROUTES, then the built files only the
    // Worker reads (src/lib/composed/paths.ts INTERNAL_ASSET_PATHS), which answer 404 in public.
    // `/api/*` covers /api/csp-report and the developer API facade under /api/v1: wrangler rejects a
    // rule another rule makes redundant.
    "run_worker_first": [
      "/",
      "/sw.js",
      "/version.json",
      "/.well-known/api-catalog",
      "/.well-known/webfinger",
      "/.well-known/ai-catalog.json",
      "/openapi.json",
      "/llms.txt",
      "/llms-full.txt",
      "/index.md",
      "/feed.xml",
      "/feed.json",
      "/sa",
      "/cf-insights.js",
      "/cf-rum",
      "/api",
      "/api/*",
      "/simple",
      "/simple/*",
      "/mcp",
      "/mcp/server-card",
      "/_ssr/value-free.json"
    ]
  },
  // NO `routes` key, on purpose (owner decision 2026-10-14, option A). The production route
  // `jonathanlloyd.me/*` lives in Cloudflare, outside wrangler, set to fail open by the owner. A deploy
  // that declares routes replaces the Worker's route set with new route objects (wrangler 4.149.0
  // `publishRoutes`, PUT .../workers/scripts/:name/routes), which reset request_limit_fail_open to
  // false; a deploy that declares none makes no route call (`triggersDeploy`: `if (routesOnly.length
  // > 0)`). Rollback and re-creation: docs/decision-0160/cutover-rehearsal-runbook.md.
  // No public workers.dev alias (decision 0160 D1).
  "workers_dev": false,
  // Version URLs on: the owner put Cloudflare Access on the Worker (gate G3, 2026-10-14), with the
  // CI service-token policy. scripts/check-preview-access.mjs verifies it on every PR. Only
  // `wrangler deploy` applies this setting; `wrangler versions upload` reads it.
  "preview_urls": true,
  "observability": {"enabled": true},
  // The page data the backend publishes for `/` (atlas decision 0164, Variant D): the `focus` state
  // and `fragments:<build>` (src/lib/composed/published.ts). ONE namespace, `human-datastream-page`,
  // for production and the previews (owner decision). A preview reads the production `focus` key
  // but never finds its own build's fragments, so it answers the value-free or data-free page; with
  // `X-SSR-Data-Plane: fixture` it reads the committed fixtures instead. The Worker only reads this
  // namespace. Local runs (wrangler dev, astro preview) simulate a namespace from the binding.
  "kv_namespaces": [{"binding": "PAGE", "id": "dc9dc20506d1401488e00993370f81b2"}],
  // The developer API facade's rate-limit counter (owner decision 2026-10-24, option B) runs in its
  // own Worker, human-datastream-rate-limiter (workers/rate-limiter/, class ClientRateLimitWindow),
  // because Cloudflare generates no Version URL for a Worker that implements a Durable Object
  // (developers.cloudflare.com/workers/configuration/previews/, Limitations: "Version URLs are not
  // generated for Workers that implement a Durable Object, including Containers and Sandbox
  // Workers."), and every PR preview of this Worker needs one. This Worker declares NO
  // `durable_objects` binding until the v2 delete below has applied: the facade (#395) adds
  // {"name": "API_RATE_LIMITER", "class_name": "ClientRateLimitWindow", "script_name":
  // "human-datastream-rate-limiter"} in a later deploy, with no new migration. No route calls the
  // counter before then.
  //
  // Migration history, legacy `migrations` array (not `exports`, which makes every `wrangler versions
  // upload` fail). Wrangler applies only the tags after the one the published Worker carries, so an
  // applied tag stays listed and is never edited. v1 created ApiRateLimiter in this Worker (#396); v2
  // deletes it here, with its stored windows, which last 60 s and are worth nothing
  // (developers.cloudflare.com/durable-objects/reference/durable-object-class-migrations-legacy/,
  // Delete migration: "first remove the binding from the Worker").
  //
  // Cloudflare refused the delete twice on 2026-10-24 with "Cannot apply --delete-class migration to
  // class 'ApiRateLimiter' without also removing the binding that references it. [code: 10061]":
  // - the #397 rollout, with the binding {API_RATE_LIMITER, class ApiRateLimiter, script_name
  //   human-datastream-rate-limiter};
  // - the #398 rollout, with the class renamed to ClientRateLimitWindow in the rate-limiter Worker
  //   and the binding pointing at it. The rename did not satisfy the check.
  // The binding had to go in the same deploy as the delete. Add a binding back only once v2 is the
  // published tag.
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["ApiRateLimiter"]}, {"tag": "v2", "deleted_classes": ["ApiRateLimiter"]}]
}
