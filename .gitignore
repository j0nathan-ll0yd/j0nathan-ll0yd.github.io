.DS_Store
.idea/
node_modules/
dist/
.astro/
.omc/
_site/
.jekyll-cache/
.sass-cache/
repomix-output.xml
repomix-lean-output.xml

# Playwright
test-results/
playwright-report/
blob-report/

# Lighthouse CI (audit-web.yml B3) -- .lighthouseci/ is LHCI's own working
# directory; lhci-reports/ is this repo's configured `upload.target: filesystem`
# outputDir. Both are per-run artifacts, uploaded by CI, never committed.
.lighthouseci/
lhci-reports/

# lychee (audit-web.yml B5) link-check cache, restored via actions/cache in CI.
.lycheecache

# direnv local-only env overrides (secrets; .envrc itself is committed)
.env.local
.direnv/

# Agent enforcement symlinks
.claude/rules/

# Local onboarding scratch docs
docs/ONBOARDING.md
docs/onboarding-review/

# Stryker mutation testing (decisions/0011, B2 spec/eval pilot): sandbox
# copies and generated reports, both reproducible from stryker.conf.json.
.stryker-tmp/
reports/mutation/

# pnpm content-addressed store. The Docker visual harness (scripts/run-in-docker.sh)
# used to write one here because pnpm places its store on the same filesystem as the
# project; the harness now pins --store-dir inside the container-private node_modules
# volume. Kept ignored as a backstop -- a stray store is ~700MB of binary blobs and
# GitHub rejects the push (single files exceed the 100MB limit).
.pnpm-store/
